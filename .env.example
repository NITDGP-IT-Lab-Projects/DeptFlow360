# ==============================================================================
# DeptFlow 360 - Environment Configuration
# Copy this file to .env and insert your MongoDB Atlas Connection String
# ==============================================================================

# MongoDB Atlas Connection String:
# Replace <username>, <password>, and <cluster-url> with your Atlas credentials:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/deptflow360?retryWrites=true&w=majority

# Backend Port (Default 5000)
PORT=5000

# Frontend Web Server Port (Default 8080)
FRONTEND_PORT=8080
